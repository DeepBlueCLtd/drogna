# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node
node_modules/
.pnpm-store/
client/dist/
.vite/

# Data — seed data is produced by scripts, never accumulated (NFR-07).
# Anchored to the repository root: an unanchored `data/` also matches
# `client/src/data/`, which is source and must be tracked.
/data/
*.nc
*.zarr/

# The one exception, and it is an exception to "never accumulated" rather than a hole in
# it. The leakage corpus under `tests/leakage/fixtures/` is not data: it is eight small
# coverages written by a committed script from a recorded seed, five of them deliberate
# controls that a gate is asserted to catch. They are tracked because FR-018 requires the
# leakage tests to run from the repository alone, with no deployment and no network, and a
# control that is not in the checkout is a control that is not run.
!tests/leakage/fixtures/**/*.nc

# The broker's password file is generated from per-role secrets at deploy time and is
# never a tracked artefact. No such file exists today; this is here so that the first run
# that produces one cannot quietly commit it.
deploy/broker/passwd
deploy/broker/**/passwd

# Local config produced from templates
config/local/*.local.json
*.env
.env

# Capture artefacts that are not durable (PR-10, FR-004, FR-012).
#
# Two of the three capture mechanisms produce nothing that is ever committed, and they
# produce it into two different areas because their lifetimes differ: a glance lives for
# the session and a pair lives for the branch. The third area holds curated candidates
# waiting for a person to look at them; a candidate becomes durable by being moved into
# site/docs/blog/assets/ by hand, which is the review gate, and never by being written
# there. The areas are named in config/<destination>/capture.json and asserted disjoint by
# client/e2e/tests/separation.test.ts, so this list and that configuration cannot drift
# apart in silence.
/.capture/
client/e2e/.artifacts/
scripts/capture/.scratch/

# Editors and OS
.DS_Store
.idea/
.vscode/

# The per-destination environment file, generated by scripts/up.sh from deploy/env.template
# and the destination's configuration. It carries the deployment secrets, so it is never
# tracked (005-compose-deployment, FR-016).
deploy/.env
deploy/.env.*

# The deployment's runtime directory: the seeding record and the artefacts the seeding
# steps digest. Reproduced by scripts/seed.sh, removed by scripts/reset.sh.
deploy/.runtime/
