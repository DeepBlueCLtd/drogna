    "limits": {
      "maximum_speed_m_per_s": 4.0,
      "maximum_depth_m": 400,
      "turn_rate_degrees_per_second": 3.0,
      "acceleration_m_per_s2": 0.05,
      "dive_rate_m_per_s": 0.5
    },
    "report_interval_ticks": 30,
    "instruments": [
      {
        "sensor_id": "nav-compass",
        "datastream_id": "ownship-course",
        "observed_property": "platform_course",
        "noise_std": 0.4,
        "unit": {
          "name": "degree true",
          "symbol": "deg",
          "definition": "degree_true"
        }
      },
      {
        "sensor_id": "nav-log",
        "datastream_id": "ownship-speed",
        "observed_property": "platform_speed",
        "noise_std": 0.03,
        "unit": {
          "name": "metre per second",
          "symbol": "m/s",
          "definition": "m s-1"
        }
      },
      {
        "sensor_id": "nav-depth",
        "datastream_id": "ownship-depth",
        "observed_property": "platform_depth",
        "noise_std": 0.2,
        "unit": {
          "name": "metre",
          "symbol": "m",
          "definition": "m"
        }
      }
    ]
