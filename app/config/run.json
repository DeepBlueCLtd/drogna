{
  "schema_version": 1,
  "scenario": "loiter",
  "clock": {
    "id": "clock",
    "epoch": "2026-01-01T00:00:00.000000Z",
    "tick_interval_us": 1000000,
    "mode": "realtime",
    "rate": 1,
    "min_rate": 0,
    "max_rate": 3600,
    "topics": { "clock": "ctl/clock" },
    "http": { "rate_path": "/api/ctl/clock/rate" },
    "heartbeat": { "topic": "ctl/heartbeat", "interval_seconds": 2, "liveness_window_seconds": 6 }
  },
  "broker": {
    "id": "broker",
    "roles": [
      { "role": "clock", "publish": ["ctl/clock", "ctl/heartbeat"], "subscribe": [] },
      { "role": "broker", "publish": ["ctl/heartbeat"], "subscribe": ["ctl/clock"] },
      {
        "role": "boundary",
        "publish": ["ctl/boundary/denial", "ctl/heartbeat"],
        "subscribe": ["ctl/clock"]
      },
      { "role": "env-generator", "publish": ["ctl/heartbeat"], "subscribe": ["ctl/clock"] },
      { "role": "sensors", "publish": ["obs/+/+", "ctl/heartbeat"], "subscribe": ["ctl/clock"] },
      {
        "role": "ingest",
        "publish": ["ctl/heartbeat"],
        "subscribe": ["obs/#", "ctl/clock"]
      },
      { "role": "feature-store", "publish": ["ctl/heartbeat"], "subscribe": ["ctl/clock"] },
      { "role": "observation-store", "publish": ["ctl/heartbeat"], "subscribe": ["ctl/clock"] },
      { "role": "query", "publish": ["ctl/heartbeat"], "subscribe": ["ctl/clock"] },
      {
        "role": "monitor",
        "publish": ["ctl/divergence", "ctl/telemetry", "ctl/heartbeat"],
        "subscribe": ["obs/#", "ctl/clock"]
      },
      {
        "role": "scheduler",
        "publish": ["ctl/run/request", "ctl/telemetry", "ctl/heartbeat"],
        "subscribe": ["ctl/divergence", "ctl/run/published", "ctl/clock"]
      },
      {
        "role": "planner",
        "publish": ["ctl/plan", "ctl/heartbeat"],
        "subscribe": ["obs/#", "ctl/run/published", "ctl/clock"]
      },
      {
        "role": "model-runner",
        "publish": ["ctl/run/started", "ctl/run/published", "ctl/heartbeat"],
        "subscribe": ["ctl/run/request", "ctl/clock"]
      },
      {
        "role": "coverage-store",
        "publish": ["cov/holdings", "ctl/heartbeat"],
        "subscribe": ["ctl/clock"]
      },
      {
        "role": "advisory-source",
        "publish": ["adv/advisories", "ctl/heartbeat"],
        "subscribe": ["ctl/clock"]
      },
      {
        "role": "advisory-store",
        "publish": ["ctl/heartbeat"],
        "subscribe": ["adv/advisories", "ctl/clock"]
      },
      {
        "role": "offload",
        "publish": ["ctl/offload", "ctl/heartbeat"],
        "subscribe": ["ctl/run/published", "ctl/clock"]
      },
      {
        "role": "telemetry",
        "publish": ["ctl/telemetry", "ctl/heartbeat"],
        "subscribe": ["ctl/telemetry", "ctl/run/published", "obs/#", "ctl/clock"]
      },
      {
        "role": "operator",
        "publish": ["ctl/heartbeat"],
        "subscribe": ["ctl/heartbeat", "ctl/clock"]
      },
      { "role": "shell", "publish": [], "subscribe": ["#"] }
    ],
    "heartbeat": { "topic": "ctl/heartbeat", "interval_seconds": 2, "liveness_window_seconds": 6 }
  },
  "boundary": {
    "id": "boundary",
    "api_prefix": "/api",
    "allow_prefixes": ["/api/ctl/", "/api/edr/", "/api/st/", "/api/features/"],
    "topics": { "denial": "ctl/boundary/denial" },
    "heartbeat": { "topic": "ctl/heartbeat", "interval_seconds": 2, "liveness_window_seconds": 6 }
  },
  "env_generator": {
    "id": "env-generator",
    "stream": "env-generator",
    "topics": { "clock": "ctl/clock" },
    "heartbeat": { "topic": "ctl/heartbeat", "interval_seconds": 2, "liveness_window_seconds": 6 },
    "domain": {
      "latitude": { "minimum": 44, "maximum": 48 },
      "longitude": { "minimum": -14, "maximum": -8 },
      "depth": { "minimum": 0, "maximum": 1000 }
    },
    "nowcast": {
      "grid": { "longitude": 24, "latitude": 20, "depth": 6 },
      "interval_ticks": 900,
      "time_steps": 4,
      "step_seconds": 3600
    },
    "archive": {
      "grid": { "longitude": 12, "latitude": 10, "depth": 4 },
      "months": 240,
      "month_seconds": 2592000
    },
    "background": {
      "surface_temperature_c": 17.5,
      "deep_temperature_c": 4.5,
      "temperature_scale_depth_m": 350,
      "surface_salinity_psu": 35.4,
      "deep_salinity_psu": 34.9,
      "salinity_scale_depth_m": 300
    },
    "features": {
      "eddy": {
        "nominal": {
          "centre_latitude": 46.1,
          "centre_longitude": -11.2,
          "radius_km": 60,
          "strength_c": 2.5,
          "salinity_strength_psu": 0.15,
          "sign": 1,
          "depth_centre_m": 150,
          "depth_half_thickness_m": 220
        },
        "jitter": { "centre_degrees": 0.4, "radius_km": 10, "strength_c": 0.5 }
      },
      "front": {
        "nominal": {
          "anchor_latitude": 47.1,
          "anchor_longitude": -9.4,
          "bearing_degrees": 40,
          "sharpness_km": 30,
          "amplitude_c": 1.2,
          "salinity_amplitude_psu": -0.2,
          "depth_scale_m": 250
        },
        "jitter": { "anchor_degrees": 0.3, "bearing_degrees": 10 }
      },
      "thermocline": {
        "nominal": {
          "depth_m": 80,
          "thickness_m": 30,
          "temperature_drop_c": 4,
          "salinity_rise_psu": 0.1
        },
        "jitter": { "depth_m": 15, "temperature_drop_c": 0.8 }
      },
      "moving": {
        "nominal": {
          "centre_latitude": 44.9,
          "centre_longitude": -12.6,
          "radius_km": 40,
          "strength_c": 1.5,
          "salinity_strength_psu": 0.1,
          "sign": -1,
          "depth_centre_m": 100,
          "depth_half_thickness_m": 160,
          "drift_east_km_per_day": 8,
          "drift_north_km_per_day": 5
        },
        "jitter": { "centre_degrees": 0.4, "drift_km_per_day": 2 }
      }
    },
    "timescale": {
      "background_seconds": 864000,
      "floor_ratio": 2,
      "feature_seconds": {
        "eddy": 432000,
        "front": 172800,
        "thermocline": 1209600,
        "moving": 86400
      }
    }
  },
  "coverage_store": {
    "id": "coverage-store",
    "topics": { "clock": "ctl/clock", "published": "cov/holdings" },
    "http": { "holdings_path": "/api/ctl/holdings" },
    "heartbeat": { "topic": "ctl/heartbeat", "interval_seconds": 2, "liveness_window_seconds": 6 }
  },
  "sensors": {
    "id": "sensors",
    "stream": "sensors-noise",
    "topics": { "clock": "ctl/clock", "observation_prefix": "obs" },
    "heartbeat": { "topic": "ctl/heartbeat", "interval_seconds": 2, "liveness_window_seconds": 6 },
    "platform": {
      "thing_id": "platform-a",
      "name": "sampling platform A",
      "description": "A simulated sampling platform. A coordinate and a sampler.",
      "loiter": {
        "centre_latitude": 46.1,
        "centre_longitude": -11.2,
        "radius_km": 45,
        "period_seconds": 43200
      }
    },
    "sample_interval_ticks": 30,
    "instruments": [
      {
        "sensor_id": "ctd-temp-050",
        "datastream_id": "temperature-050m",
        "observed_property": "temperature",
        "depth_m": 50,
        "noise_std": 0.02,
        "unit": { "name": "degree Celsius", "symbol": "degC", "definition": "degree_C" }
      },
      {
        "sensor_id": "ctd-sal-050",
        "datastream_id": "salinity-050m",
        "observed_property": "salinity",
        "depth_m": 50,
        "noise_std": 0.01,
        "unit": { "name": "practical salinity unit", "symbol": "psu", "definition": "1e-3" }
      },
      {
        "sensor_id": "ctd-temp-200",
        "datastream_id": "temperature-200m",
        "observed_property": "temperature",
        "depth_m": 200,
        "noise_std": 0.02,
        "unit": { "name": "degree Celsius", "symbol": "degC", "definition": "degree_C" }
      },
      {
        "sensor_id": "ctd-pres-200",
        "datastream_id": "pressure-200m",
        "observed_property": "pressure",
        "depth_m": 200,
        "noise_std": 0.5,
        "unit": { "name": "decibar", "symbol": "dbar", "definition": "dbar" }
      }
    ]
  },
  "ingest": {
    "id": "ingest",
    "topics": { "clock": "ctl/clock", "observations": "obs/#" },
    "heartbeat": { "topic": "ctl/heartbeat", "interval_seconds": 2, "liveness_window_seconds": 6 }
  },
  "observation_store": {
    "id": "observation-store",
    "topics": { "clock": "ctl/clock" },
    "heartbeat": { "topic": "ctl/heartbeat", "interval_seconds": 2, "liveness_window_seconds": 6 }
  },
  "query": {
    "id": "query",
    "topics": { "clock": "ctl/clock" },
    "http": {
      "edr_prefix": "/api/edr",
      "st_prefix": "/api/st/v1.1",
      "subsets_path": "/api/ctl/query-subsets",
      "features_prefix": "/api/features"
    },
    "heartbeat": { "topic": "ctl/heartbeat", "interval_seconds": 2, "liveness_window_seconds": 6 }
  },
  "monitor": {
    "id": "monitor",
    "topics": {
      "clock": "ctl/clock",
      "observations": "obs/#",
      "divergence": "ctl/divergence",
      "telemetry": "ctl/telemetry"
    },
    "heartbeat": { "topic": "ctl/heartbeat", "interval_seconds": 2, "liveness_window_seconds": 6 },
    "pairs": [
      {
        "thing_id": "platform-a",
        "temperature_datastream": "temperature-050m",
        "salinity_datastream": "salinity-050m",
        "depth_m": 50
      }
    ],
    "threshold_m_per_s": 1.2,
    "persistence_count": 3,
    "region": { "radius_m": 60000, "depth_pad_m": 40 }
  },
  "scheduler": {
    "id": "scheduler",
    "topics": {
      "clock": "ctl/clock",
      "divergence": "ctl/divergence",
      "run_request": "ctl/run/request",
      "run_published": "ctl/run/published",
      "telemetry": "ctl/telemetry"
    },
    "heartbeat": { "topic": "ctl/heartbeat", "interval_seconds": 2, "liveness_window_seconds": 6 },
    "min_interval_ticks": 600,
    "max_interval_ticks": 1800,
    "ensemble_size": 5
  },
  "model_runner": {
    "id": "model-runner",
    "stream": "model-runner",
    "topics": {
      "clock": "ctl/clock",
      "run_request": "ctl/run/request",
      "run_started": "ctl/run/started",
      "run_published": "ctl/run/published"
    },
    "heartbeat": { "topic": "ctl/heartbeat", "interval_seconds": 2, "liveness_window_seconds": 6 },
    "kernel": "shift-advect-v1",
    "steps": 4,
    "step_seconds": 900,
    "advection": { "east_km_per_day": 4, "north_km_per_day": 2 },
    "noise_std": { "temperature": 0.35, "salinity": 0.03 }
  },
  "planner": {
    "id": "planner",
    "stream": "planner-restarts",
    "topics": {
      "clock": "ctl/clock",
      "observations": "obs/#",
      "run_published": "ctl/run/published",
      "plan": "ctl/plan"
    },
    "heartbeat": { "topic": "ctl/heartbeat", "interval_seconds": 2, "liveness_window_seconds": 6 },
    "replan_interval_ticks": 600,
    "region_feature": "loiter-region",
    "h3_resolution": 5,
    "depth_bands": [
      { "index": 0, "minimum_depth_m": 0, "maximum_depth_m": 120 },
      { "index": 1, "minimum_depth_m": 120, "maximum_depth_m": 400 }
    ],
    "budget_seconds": 21600,
    "speeds": { "horizontal_m_per_s": 2.5, "vertical_m_per_s": 0.5 },
    "footprint": {
      "peak": 0.85,
      "horizontal_efolding_m": 12000,
      "vertical_efolding_m": 120,
      "rings": 2,
      "band_reach": 1
    },
    "usable_threshold": 0.12,
    "restarts": 4,
    "shortlist": 3,
    "projection": { "step_seconds": 1800, "horizon_seconds": 21600 }
  },
  "telemetry": {
    "id": "telemetry",
    "topics": {
      "clock": "ctl/clock",
      "telemetry": "ctl/telemetry",
      "run_published": "ctl/run/published",
      "observations": "obs/#"
    },
    "http": { "report_path": "/api/ctl/telemetry" },
    "heartbeat": { "topic": "ctl/heartbeat", "interval_seconds": 2, "liveness_window_seconds": 6 },
    "cadence_ticks": 300,
    "staleness_window_seconds": 1800,
    "minimum_skill_samples": 5
  },
  "operator": {
    "id": "operator",
    "topics": { "clock": "ctl/clock", "heartbeat": "ctl/heartbeat" },
    "http": {
      "components_path": "/api/ctl/components",
      "step_path": "/api/ctl/clock/step",
      "command_prefix": "/api/ctl/components"
    },
    "heartbeat": { "topic": "ctl/heartbeat", "interval_seconds": 2, "liveness_window_seconds": 6 },
    "protected": ["clock", "broker", "boundary", "operator", "coverage-store", "observation-store", "feature-store", "advisory-store", "query", "telemetry"]
  },
  "advisory_source": {
    "id": "advisory-source",
    "stream": "advisory-source",
    "topics": { "clock": "ctl/clock", "advisory": "adv/advisories" },
    "heartbeat": { "topic": "ctl/heartbeat", "interval_seconds": 2, "liveness_window_seconds": 6 },
    "cadence_ticks": 1200,
    "valid_seconds": 14400,
    "region_feature": "loiter-region",
    "depth_span_m": 250,
    "sound_speed_half_width_m_per_s": 6
  },
  "advisory_store": {
    "id": "advisory-store",
    "topics": { "clock": "ctl/clock", "advisory": "adv/advisories" },
    "heartbeat": { "topic": "ctl/heartbeat", "interval_seconds": 2, "liveness_window_seconds": 6 },
    "size_ceiling_bytes": 2048
  },
  "offload": {
    "id": "offload",
    "topics": {
      "clock": "ctl/clock",
      "run_published": "ctl/run/published",
      "offload": "ctl/offload"
    },
    "heartbeat": { "topic": "ctl/heartbeat", "interval_seconds": 2, "liveness_window_seconds": 6 },
    "identification_radius_m": 60000,
    "format_version": "drogna-bundle-2.0",
    "staging_bound_bytes": 8388608
  },
  "feature_store": {
    "id": "feature-store",
    "topics": { "clock": "ctl/clock" },
    "heartbeat": { "topic": "ctl/heartbeat", "interval_seconds": 2, "liveness_window_seconds": 6 },
    "features": [
      {
        "feature_id": "domain",
        "name": "scenario domain",
        "kind": "domain",
        "geometry": {
          "type": "Polygon",
          "coordinates": [[[-14, 44], [-8, 44], [-8, 48], [-14, 48], [-14, 44]]]
        }
      },
      {
        "feature_id": "loiter-region",
        "name": "loiter region",
        "kind": "loiter_region",
        "geometry": {
          "type": "Polygon",
          "coordinates": [[[-11.8, 45.7], [-10.6, 45.7], [-10.6, 46.5], [-11.8, 46.5], [-11.8, 45.7]]]
        }
      }
    ]
  },
  "shell": {
    "id": "shell",
    "role": "shell",
    "views": [
      { "id": "intro", "label": "Intro" },
      { "id": "system", "label": "System" },
      { "id": "holdings", "label": "Holdings" },
      { "id": "operator", "label": "Operator" },
      { "id": "map", "label": "Map" },
      { "id": "messages", "label": "Messages" }
    ],
    "components": [
      { "id": "clock", "label": "Simulation clock", "beat": 101 },
      { "id": "broker", "label": "Broker", "beat": 101 },
      { "id": "boundary", "label": "Release gate", "beat": 101 },
      { "id": "env-generator", "label": "Environment generator", "beat": 102 },
      { "id": "coverage-store", "label": "Coverage store", "beat": 102 },
      { "id": "sensors", "label": "Sensors", "beat": 103 },
      { "id": "ingest", "label": "Ingestion seam", "beat": 103 },
      { "id": "observation-store", "label": "Observation store", "beat": 103 },
      { "id": "feature-store", "label": "Feature store", "beat": 103 },
      { "id": "query", "label": "Query components", "beat": 104 },
      { "id": "monitor", "label": "Monitor", "beat": 105 },
      { "id": "scheduler", "label": "Scheduler", "beat": 105 },
      { "id": "model-runner", "label": "Model runner", "beat": 105 },
      { "id": "planner", "label": "Planner", "beat": 106 },
      { "id": "telemetry", "label": "Telemetry", "beat": 107 },
      { "id": "operator", "label": "Operator surface", "beat": 107 },
      { "id": "advisory-source", "label": "Shore advisory source", "beat": 108 },
      { "id": "advisory-store", "label": "Advisory store", "beat": 108 },
      { "id": "offload", "label": "Offload packager", "beat": 108 }
    ],
    "topics": {
      "clock": "ctl/clock",
      "heartbeat": "ctl/heartbeat",
      "holdings": "cov/holdings",
      "all": "#"
    },
    "message_schemas": [
      { "filter": "ctl/clock", "schema": "clock" },
      { "filter": "ctl/heartbeat", "schema": "heartbeat" },
      { "filter": "ctl/boundary/denial", "schema": "boundary-denial" },
      { "filter": "cov/holdings", "schema": "holding-published" },
      { "filter": "obs/#", "schema": "observation" },
      { "filter": "ctl/divergence", "schema": "divergence" },
      { "filter": "ctl/run/request", "schema": "run-request" },
      { "filter": "ctl/run/started", "schema": "run-started" },
      { "filter": "ctl/run/published", "schema": "run-published" },
      { "filter": "ctl/plan", "schema": "plan" },
      { "filter": "ctl/telemetry", "schema": "telemetry" },
      { "filter": "adv/advisories", "schema": "advisory" },
      { "filter": "ctl/offload", "schema": "offload-telemetry" }
    ],
    "endpoints": {
      "clock_rate": "/api/ctl/clock/rate",
      "holdings": "/api/ctl/holdings",
      "components": "/api/ctl/components",
      "telemetry": "/api/ctl/telemetry",
      "clock_step": "/api/ctl/clock/step",
      "component_command": "/api/ctl/components"
    },
    "liveness": { "default_window_seconds": 6 },
    "messages": { "buffer": 200 }
  }
}
