  "env_generator": {
    "id": "env-generator",
    "stream": "env-generator",
    "topics": {
      "clock": "ctl/clock",
      "command": "ctl/operator/command"
    },
    "heartbeat": {
      "topic": "ctl/heartbeat",
      "interval_seconds": 2,
      "liveness_window_seconds": 6
    },
    "domain": {
      "latitude": {
        "minimum": 44,
        "maximum": 48
      },
      "longitude": {
        "minimum": -14,
        "maximum": -8
      },
      "depth": {
        "minimum": 0,
        "maximum": 1000
      }
    },
    "nowcast": {
      "grid": {
        "longitude": 96,
        "latitude": 80,
        "depth": 6
      },
      "interval_ticks": 900,
      "time_steps": 4,
      "step_seconds": 3600
    },
    "archive": {
      "grid": {
        "longitude": 12,
        "latitude": 10,
        "depth": 4
      },
      "months": 240,
      "month_seconds": 2592000
    },
    "background": {
      "surface_temperature_c": 17.5,
      "deep_temperature_c": 4.5,
      "temperature_scale_depth_m": 350,
      "surface_salinity_psu": 35.4,
      "deep_salinity_psu": 34.9,
      "salinity_scale_depth_m": 300
    },
    "features": {
      "eddy": {
        "nominal": {
          "centre_latitude": 46.1,
          "centre_longitude": -11.2,
          "radius_km": 60,
          "strength_c": 2.5,
          "salinity_strength_psu": 0.15,
          "sign": 1,
          "depth_centre_m": 150,
          "depth_half_thickness_m": 220
        },
        "jitter": {
          "centre_degrees": 0.4,
          "radius_km": 10,
          "strength_c": 0.5
        }
      },
      "front": {
        "nominal": {
          "anchor_latitude": 47.1,
          "anchor_longitude": -9.4,
          "bearing_degrees": 40,
          "sharpness_km": 30,
          "amplitude_c": 1.2,
          "salinity_amplitude_psu": -0.2,
          "depth_scale_m": 250
        },
        "jitter": {
          "anchor_degrees": 0.3,
          "bearing_degrees": 10
        }
      },
      "thermocline": {
        "nominal": {
          "depth_m": 80,
          "thickness_m": 30,
          "temperature_drop_c": 4,
          "salinity_rise_psu": 0.1
        },
        "jitter": {
          "depth_m": 15,
          "temperature_drop_c": 0.8
        }
      },
      "moving": {
        "nominal": {
          "centre_latitude": 44.9,
          "centre_longitude": -12.6,
          "radius_km": 40,
          "strength_c": 1.5,
          "salinity_strength_psu": 0.1,
          "sign": -1,
          "depth_centre_m": 100,
          "depth_half_thickness_m": 160,
          "drift_east_km_per_day": 8,
          "drift_north_km_per_day": 5
        },
        "jitter": {
          "centre_degrees": 0.4,
          "drift_km_per_day": 2
        }
      }
    },
    "timescale": {
      "background_seconds": 864000,
      "floor_ratio": 2,
      "feature_seconds": {
        "eddy": 432000,
        "front": 172800,
        "thermocline": 1209600,
        "moving": 86400
      }
    },
    "prompt_event": "nowcast-now"
  },
  "coverage_store": {
    "id": "coverage-store",
    "topics": {
      "clock": "ctl/clock",
      "published": "cov/holdings"
    },
    "http": {
      "holdings_path": "/api/ctl/holdings"
    },
    "heartbeat": {
      "topic": "ctl/heartbeat",
      "interval_seconds": 2,
      "liveness_window_seconds": 6
    }
  },
  "platform": {
    "id": "platform",
    "stream": "platform-navigation",
    "topics": {
      "clock": "ctl/clock",
      "demand": "ctl/platform/demand",
      "state": "ctl/platform/state",
      "observation_prefix": "obs",
      "command": "ctl/operator/command"
    },
    "heartbeat": {
      "topic": "ctl/heartbeat",
      "interval_seconds": 2,
      "liveness_window_seconds": 6
    },
    "thing": {
      "thing_id": "ownship",
      "name": "ownship",
      "description": "The simulated vehicle the sampling platform rides on. Its own datastreams carry its motion, and a series of them is its track."
    },
    "initial": {
      "latitude": 46.1,
      "longitude": -11.2,
      "course_degrees": 90,
      "speed_m_per_s": 2.4,
      "depth_m": 50
    },
    "limits": {
      "maximum_speed_m_per_s": 4.0,
      "maximum_depth_m": 400,
      "turn_rate_degrees_per_second": 3.0,
      "acceleration_m_per_s2": 0.05,
      "dive_rate_m_per_s": 0.5
    },
    "report_interval_ticks": 5,
    "instruments": [
      {
        "sensor_id": "nav-compass",
        "datastream_id": "ownship-course",
        "observed_property": "platform_course",
        "noise_std": 0.4,
        "unit": {
          "name": "degree true",
          "symbol": "deg",
          "definition": "degree_true"
        }
      },
      {
        "sensor_id": "nav-log",
        "datastream_id": "ownship-speed",
        "observed_property": "platform_speed",
        "noise_std": 0.03,
        "unit": {
          "name": "metre per second",
          "symbol": "m/s",
          "definition": "m s-1"
        }
      },
      {
        "sensor_id": "nav-depth",
        "datastream_id": "ownship-depth",
        "observed_property": "platform_depth",
        "noise_std": 0.2,
        "unit": {
          "name": "metre",
          "symbol": "m",
          "definition": "m"
        }
      }
    ],
    "fault_event": "fault-depth"
  },
  "sensors": {
    "id": "sensors",
    "stream": "sensors-noise",
    "topics": {
      "clock": "ctl/clock",
      "ownship": "obs/ownship/+",
      "observation_prefix": "obs",
      "command": "ctl/operator/command"
    },
    "heartbeat": {
      "topic": "ctl/heartbeat",
      "interval_seconds": 2,
      "liveness_window_seconds": 6
    },
    "platform": {
      "thing_id": "platform-a",
      "name": "sampling platform A",
      "description": "A simulated sampling platform. A coordinate and a sampler."
    },
    "sample_interval_ticks": 5,
    "instruments": [
      {
        "sensor_id": "ctd-temp-050",
        "datastream_id": "temperature-050m",
        "observed_property": "temperature",
        "depth_m": 50,
        "noise_std": 0.02,
        "unit": {
          "name": "degree Celsius",
          "symbol": "degC",
          "definition": "degree_C"
        }
      },
      {
        "sensor_id": "ctd-sal-050",
        "datastream_id": "salinity-050m",
        "observed_property": "salinity",
        "depth_m": 50,
        "noise_std": 0.01,
        "unit": {
          "name": "practical salinity unit",
          "symbol": "psu",
          "definition": "1e-3"
        }
      },
      {
        "sensor_id": "ctd-temp-200",
        "datastream_id": "temperature-200m",
        "observed_property": "temperature",
        "depth_m": 200,
        "noise_std": 0.02,
        "unit": {
          "name": "degree Celsius",
          "symbol": "degC",
          "definition": "degree_C"
        }
      },
      {
        "sensor_id": "ctd-pres-200",
        "datastream_id": "pressure-200m",
        "observed_property": "pressure",
        "depth_m": 200,
        "noise_std": 0.5,
        "unit": {
          "name": "decibar",
          "symbol": "dbar",
          "definition": "dbar"
        }
      }
    ],
    "fault_event": "fault-sample"
  },
  "ingest": {
    "id": "ingest",
    "topics": {
