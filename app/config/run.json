{
  "schema_version": 1,
  "scenario": "loiter",
  "clock": {
    "id": "clock",
    "epoch": "2026-01-01T00:00:00.000000Z",
    "tick_interval_us": 1000000,
    "mode": "realtime",
    "rate": 1,
    "min_rate": 0,
    "max_rate": 3600,
    "topics": {
      "clock": "ctl/clock"
    },
    "http": {
      "rate_path": "/api/ctl/clock/rate"
    },
    "heartbeat": {
      "topic": "ctl/heartbeat",
      "interval_seconds": 2,
      "liveness_window_seconds": 6
    }
  },
  "broker": {
    "id": "broker",
    "roles": [
      {
        "role": "clock",
        "publish": [
          "ctl/clock",
          "ctl/heartbeat"
        ],
        "subscribe": []
      },
      {
        "role": "broker",
        "publish": [
          "ctl/heartbeat"
        ],
        "subscribe": [
          "ctl/clock"
        ]
      },
      {
        "role": "boundary",
        "publish": [
          "ctl/boundary/denial",
          "ctl/heartbeat"
        ],
        "subscribe": [
          "ctl/clock"
        ]
      },
      {
        "role": "env-generator",
        "publish": [
          "ctl/heartbeat"
        ],
        "subscribe": [
          "ctl/operator/command",
          "ctl/clock"
        ]
      },
      {
        "role": "platform",
        "publish": [
          "obs/ownship/+",
          "ctl/platform/state",
          "ctl/heartbeat"
        ],
        "subscribe": [
          "ctl/operator/command",
          "ctl/platform/demand",
          "ctl/clock"
        ]
      },
      {
        "role": "sensors",
        "publish": [
          "obs/+/+",
          "ctl/heartbeat"
        ],
        "subscribe": [
          "ctl/operator/command",
          "obs/ownship/+",
          "ctl/clock"
        ]
      },
      {
        "role": "ingest",
        "publish": [
          "ctl/heartbeat"
        ],
        "subscribe": [
          "obs/#",
          "ctl/clock"
        ]
      },
      {
        "role": "feature-store",
        "publish": [
          "ctl/heartbeat"
        ],
        "subscribe": [
          "ctl/clock"
        ]
      },
      {
        "role": "observation-store",
        "publish": [
          "ctl/heartbeat"
        ],
        "subscribe": [
          "ctl/clock"
        ]
      },
      {
        "role": "query",
        "publish": [
          "ctl/heartbeat"
        ],
        "subscribe": [
          "ctl/clock"
        ]
      },
      {
        "role": "monitor",
        "publish": [
          "ctl/divergence",
          "ctl/telemetry",
          "ctl/heartbeat"
        ],
        "subscribe": [
          "ctl/operator/command",
          "obs/#",
          "ctl/clock"
        ]
      },
      {
        "role": "scheduler",
        "publish": [
          "ctl/run/request",
          "ctl/telemetry",
          "ctl/heartbeat"
        ],
        "subscribe": [
          "ctl/operator/command",
          "ctl/divergence",
          "ctl/run/published",
          "ctl/clock"
        ]
      },
      {
        "role": "planner",
        "publish": [
          "ctl/plan",
          "ctl/heartbeat"
        ],
        "subscribe": [
          "ctl/operator/command",
          "obs/#",
          "ctl/analysis/published",
          "ctl/clock"
        ]
      },
      {
        "role": "analyst",
        "publish": [
          "ctl/analysis/published",
          "ctl/heartbeat"
        ],
        "subscribe": [
          "obs/#",
          "ctl/run/request",
          "ctl/run/published",
          "ctl/clock"
        ]
      },
      {
        "role": "model-runner",
        "publish": [
          "ctl/run/started",
          "ctl/run/published",
          "ctl/heartbeat"
        ],
        "subscribe": [
          "ctl/analysis/published",
          "ctl/clock"
        ]
      },
      {
        "role": "coverage-store",
        "publish": [
          "cov/holdings",
          "ctl/heartbeat"
        ],
        "subscribe": [
          "ctl/clock"
        ]
      },
      {
        "role": "advisory-source",
        "publish": [
          "adv/advisories",
          "ctl/heartbeat"
        ],
        "subscribe": [
          "ctl/operator/command",
          "ctl/clock"
        ]
      },
      {
        "role": "advisory-store",
        "publish": [
          "ctl/heartbeat"
        ],
        "subscribe": [
          "adv/advisories",
          "ctl/clock"
        ]
      },
      {
        "role": "offload",
        "publish": [
          "ctl/offload",
          "ctl/heartbeat"
        ],
        "subscribe": [
          "ctl/operator/command",
          "ctl/run/published",
          "ctl/clock"
        ]
      },
      {
        "role": "telemetry",
        "publish": [
          "ctl/telemetry",
          "ctl/heartbeat"
        ],
        "subscribe": [
          "ctl/telemetry",
          "ctl/run/published",
          "obs/#",
          "ctl/clock"
        ]
      },
      {
        "role": "operator",
        "publish": [
          "ctl/heartbeat",
          "ctl/platform/demand",
          "ctl/operator/command"
        ],
        "subscribe": [
          "ctl/heartbeat",
          "ctl/clock"
        ]
      },
      {
        "role": "shell",
        "publish": [],
        "subscribe": [
          "#"
        ]
      }
    ],
    "heartbeat": {
      "topic": "ctl/heartbeat",
      "interval_seconds": 2,
      "liveness_window_seconds": 6
    }
  },
  "boundary": {
    "id": "boundary",
    "api_prefix": "/api",
    "allow_prefixes": [
      "/api/ctl/",
      "/api/edr/",
      "/api/st/",
      "/api/features/"
    ],
    "topics": {
      "denial": "ctl/boundary/denial"
    },
    "heartbeat": {
      "topic": "ctl/heartbeat",
      "interval_seconds": 2,
      "liveness_window_seconds": 6
    }
