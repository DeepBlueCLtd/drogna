    }
  },
  "monitor": {
    "id": "monitor",
    "topics": {
      "clock": "ctl/clock",
      "observations": "obs/#",
      "divergence": "ctl/divergence",
      "telemetry": "ctl/telemetry",
      "command": "ctl/operator/command"
    },
    "heartbeat": {
      "topic": "ctl/heartbeat",
      "interval_seconds": 2,
      "liveness_window_seconds": 6
    },
    "pairs": [
      {
        "thing_id": "platform-a",
        "temperature_datastream": "temperature-050m",
        "salinity_datastream": "salinity-050m",
        "depth_m": 50
      }
    ],
    "threshold_m_per_s": 1.2,
    "persistence_count": 3,
    "region": {
      "radius_m": 60000,
      "depth_pad_m": 40
    }
  },
  "scheduler": {
    "id": "scheduler",
    "topics": {
      "clock": "ctl/clock",
      "divergence": "ctl/divergence",
      "run_request": "ctl/run/request",
      "run_published": "ctl/run/published",
      "telemetry": "ctl/telemetry",
      "command": "ctl/operator/command"
    },
    "heartbeat": {
      "topic": "ctl/heartbeat",
      "interval_seconds": 2,
      "liveness_window_seconds": 6
    },
    "min_interval_ticks": 600,
    "max_interval_ticks": 1800,
    "ensemble_size": 5,
    "prompt_event": "run-now"
  },
  "model_runner": {
    "id": "model-runner",
    "stream": "model-runner",
    "topics": {
      "clock": "ctl/clock",
      "run_request": "ctl/run/request",
      "analysis_published": "ctl/analysis/published",
      "run_started": "ctl/run/started",
      "run_published": "ctl/run/published"
    },
    "heartbeat": {
      "topic": "ctl/heartbeat",
      "interval_seconds": 2,
      "liveness_window_seconds": 6
    },
    "kernel": "shift-advect-v1",
    "steps": 4,
    "step_seconds": 900,
    "advection": {
      "east_km_per_day": 4,
      "north_km_per_day": 2
    },
    "noise_std": {
      "temperature": 0.35,
      "salinity": 0.03
    }
  },
  "analyst": {
    "id": "analyst",
    "stream": "analyst-perturbations",
    "topics": {
      "clock": "ctl/clock",
      "observations": "obs/#",
      "run_request": "ctl/run/request",
      "run_published": "ctl/run/published",
      "analysis_published": "ctl/analysis/published"
    },
    "heartbeat": {
      "topic": "ctl/heartbeat",
      "interval_seconds": 2,
      "liveness_window_seconds": 6
    },
    "correlation": {
      "horizontal_km": 30,
      "vertical_m": 160
    },
    "excluded_datastreams": [
      "ownship-course",
      "ownship-speed",
      "ownship-depth"
    ],
    "shares": {
      "archive": "archive",
      "departure": "departure forecast",
      "measurement": "measurement",
      "model": "model"
    }
  },
  "planner": {
    "id": "planner",
    "stream": "planner-restarts",
    "topics": {
      "clock": "ctl/clock",
      "observations": "obs/#",
      "run_published": "ctl/run/published",
      "plan": "ctl/plan",
      "command": "ctl/operator/command"
    },
    "heartbeat": {
      "topic": "ctl/heartbeat",
      "interval_seconds": 2,
      "liveness_window_seconds": 6
    },
    "excluded_datastreams": [
      "ownship-course",
      "ownship-speed",
      "ownship-depth"
    ],
    "replan_interval_ticks": 600,
    "region_feature": "loiter-region",
    "h3_resolution": 5,
    "depth_bands": [
      {
        "index": 0,
        "minimum_depth_m": 0,
        "maximum_depth_m": 120
      },
      {
        "index": 1,
        "minimum_depth_m": 120,
        "maximum_depth_m": 400
      }
    ],
    "budget_seconds": 21600,
    "speeds": {
      "horizontal_m_per_s": 2.5,
      "vertical_m_per_s": 0.5
    },
    "usable_threshold": 0.12,
    "restarts": 4,
    "shortlist": 3,
    "projection": {
      "step_seconds": 1800,
      "horizon_seconds": 21600
    },
    "prompt_event": "replan-now"
  },
  "telemetry": {
    "id": "telemetry",
    "topics": {
      "clock": "ctl/clock",
      "telemetry": "ctl/telemetry",
      "run_published": "ctl/run/published",
      "observations": "obs/#"
    },
    "http": {
      "report_path": "/api/ctl/telemetry"
    },
    "heartbeat": {
      "topic": "ctl/heartbeat",
      "interval_seconds": 2,
      "liveness_window_seconds": 6
    },
    "cadence_ticks": 300,
    "staleness_window_seconds": 1800,
    "minimum_skill_samples": 5,
    "regions": {
      "rows": 2,
      "columns": 3,
      "minimum_samples": 3
    }
  },
  "operator": {
    "id": "operator",
    "topics": {
      "clock": "ctl/clock",
      "heartbeat": "ctl/heartbeat",
      "platform_demand": "ctl/platform/demand",
      "command": "ctl/operator/command"
    },
    "http": {
      "components_path": "/api/ctl/components",
      "step_path": "/api/ctl/clock/step",
      "command_prefix": "/api/ctl/components",
      "platform_demand_path": "/api/ctl/platform/demand",
      "controls_path": "/api/ctl/controls",
      "tuning_path": "/api/ctl/tuning",
      "event_prefix": "/api/ctl/events"
    },
    "heartbeat": {
      "topic": "ctl/heartbeat",
      "interval_seconds": 2,
      "liveness_window_seconds": 6
    },
    "protected": [
      "clock",
      "broker",
      "boundary",
      "operator",
      "coverage-store",
      "observation-store",
      "feature-store",
      "advisory-store",
      "query",
      "telemetry"
    ],
    "step": {
      "maximum_ticks": 60
    },
    "demand": {
      "target": "platform"
    },
    "tunables": [
      {
        "id": "drift-threshold",
        "target": "monitor",
        "setting": "threshold_m_per_s",
        "label": "drift threshold",
        "unit": "m/s",
        "minimum": 0.2,
        "maximum": 6,
        "step": 0.1,
        "integer": false,
        "figure": "threshold",
        "description": "How far a measured sound speed may sit from the forecast before the sample counts as breaching. Lower it and the loop turns sooner."
      },
      {
        "id": "persistence",
        "target": "monitor",
        "setting": "persistence_count",
        "label": "persistence",
        "unit": "samples",
        "minimum": 2,
        "maximum": 12,
        "step": 1,
        "integer": true,
        "figure": "persistence",
        "description": "Consecutive breaching samples before a divergence is raised. Never one: a single spike is not drift."
      },
      {
        "id": "minimum-interval",
        "target": "scheduler",
        "setting": "min_interval_ticks",
        "label": "minimum interval",
        "unit": "ticks",
        "minimum": 30,
        "maximum": 3600,
        "step": 10,
        "integer": true,
        "figure": "min_interval",
        "description": "No two runs closer together than this. A divergence inside it is declined by policy, and the decline is published."
      },
      {
        "id": "cadence-floor",
        "target": "scheduler",
        "setting": "max_interval_ticks",
        "label": "cadence floor",
        "unit": "ticks",
        "minimum": 60,
        "maximum": 7200,
        "step": 10,
        "integer": true,
        "figure": "max_interval",
        "description": "The interval after which a run is warranted on schedule alone, once the current run's validity has lapsed."
      },
      {
        "id": "sampling-cadence",
        "target": "sensors",
        "setting": "sample_interval_ticks",
        "label": "sampling cadence",
        "unit": "ticks",
        "minimum": 5,
        "maximum": 300,
        "step": 5,
        "integer": true,
        "figure": "sample_interval",
        "description": "How often the instruments sample the ocean. The loop’s master dial: shorten it and residuals, store growth and the monitor’s streak all quicken. It is also how long a heard position stays fresh, so shortening it below the platform’s reporting interval makes the sensors go quiet for want of a current position — they say so, and the dial below is the other half of the pair."
      },
      {
        "id": "usable-doubt",
        "target": "planner",
        "setting": "usable_threshold",
        "label": "usable doubt",
        "minimum": 0.02,
        "maximum": 0.9,
        "step": 0.01,
        "integer": false,
        "figure": "usable_threshold",
        "description": "The doubt above which the planner calls a region unusable. Raise it and fewer regions are worth visiting; the planner still recommends and commands nothing."
      },
      {
        "id": "ownship-reporting",
        "target": "platform",
        "setting": "report_interval_ticks",
        "label": "ownship reporting",
        "unit": "ticks",
        "minimum": 1,
        "maximum": 300,
        "step": 1,
        "integer": true,
        "figure": "report_interval",
        "description": "How often the platform reports where it is. The sensors sample where it last said it was and treat a position older than their own cadence as no position at all, so this is the dial that keeps them supplied when their cadence is shortened."
      }
    ],
    "events": [
      {
        "id": "run-now",
        "target": "scheduler",
        "label": "request a forecast run",
        "description": "Ask the scheduler to consider a run now. It answers under the policy it applies to a divergence, so it may decline inside the minimum interval or while a run is outstanding — and either way the decision is published."
      },
      {
        "id": "advisory-now",
        "target": "advisory-source",
        "label": "author an advisory",
        "description": "Ask the shore source to author the next advisory in its sequence now rather than at its cadence. Prompted or not, it is the same deterministic next one."
      },
      {
        "id": "nowcast-now",
        "target": "env-generator",
        "label": "publish a now-cast",
        "description": "Ask the ocean generator to author and publish its next now-cast now rather than at its cadence. It supersedes the one before it — there is one now-cast at a time — and lands in the coverage store and on the map. It does not change what the sensors read: they sample the world through their own port, continuously."
      },
      {
        "id": "replan-now",
        "target": "planner",
        "label": "recompute the plan",
        "description": "Ask the planner to recompute now rather than at its replan interval. With no uncertainty field to work from it says so in its heartbeat and publishes no hollow plan. It recommends either way; nothing here turns a recommendation into an order."
      },
      {
        "id": "offload-now",
        "target": "offload",
        "label": "stage a package",
        "description": "Ask the packager to stage a window now over the release it last heard. It answers under the rules it already has: declined at its staging bound, and declined where the interval holds no measurements, because a bundle nobody can score is not staged."
      },
      {
        "id": "fault-sample",
        "target": "sensors",
        "label": "publish a faulty sample",
        "description": "Ask the instruments to publish one deliberately malformed observation. The ingestion seam refuses it against the committed master and names the fault; the sensors count what they were asked to produce and say so."
      },
      {
        "id": "fault-depth",
        "target": "platform",
        "label": "report an impossible depth",
        "description": "Ask the platform to report one depth beyond the maximum it declares it can reach. The ingestion seam flags it against the platform’s own limits and names the bound; the platform counts what it was asked to produce and says so."
      }
    ]
  },
