{
  "broker": {
    "url": "wss://drogna_viewer@drogna.invalid/ctl",
    "client_id": "client_droplet",
    "keepalive_seconds": 30,
    "reconnect_period_seconds": 5
  },
  "clock": {
    "stale_after_seconds": 10,
    "endpoint": "https://drogna.invalid",
    "routes": {
      "snapshot": "/clock/snapshot",
      "control": "/clock/control"
    }
  },
  "query": {
    "endpoint": "https://drogna.invalid",
    "collections_path": "/released",
    "trajectory_path": "/trajectory",
    "route_parameters": [
      "sea_water_temperature",
      "sea_water_practical_salinity"
    ],
    "cube_path": "/cube",
    "field_parameter": "temperature_uncertainty"
  },
  "liveness": {
    "default_window_seconds": 15,
    "window_multiplier": 3,
    "disconnected_is_indeterminate": true
  },
  "display": {
    "frame_interval_ms": 100,
    "buffer_depth": 64,
    "coalescing_threshold": 8,
    "maximum_drawn_cells": 4096,
    "interpolate_between_samples": true
  },
  "map": {
    "extent": {
      "minimum_longitude": -6.0,
      "minimum_latitude": 48.0,
      "maximum_longitude": -3.0,
      "maximum_latitude": 50.0
    },
    "vertical": {
      "minimum_depth_m": 0.0,
      "maximum_depth_m": 1000.0
    },
    "graticule_spacing_degrees": 0.5
  }
}
