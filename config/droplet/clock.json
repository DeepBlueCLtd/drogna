{
  "component": {
    "id": "clock",
    "description": "C-01: the single source of simulation time, and drogna's first liveness signal.",
    "heartbeat_interval_seconds": 5.0
  },
  "clock": {
    "endpoint": "http://clock:8090",
    "routes": {
      "snapshot": "/clock/snapshot",
      "control": "/clock/control"
    },
    "mode": "accelerated",
    "stale_after_gap": 8,
    "timeout_seconds": 10.0
  },
  "seed": {
    "root": 20260826,
    "stream": "clock"
  },
  "broker": {
    "url": "mqtt://broker:1883",
    "client_id": "clock",
    "keepalive_seconds": 30
  },
  "logging": {
    "level": "WARNING"
  },
  "clock_service": {
    "bind": {
      "host": "0.0.0.0",
      "port": 8090
    },
    "epoch": "2026-01-01T00:00:00.000000Z",
    "tick_interval_us": 100000,
    "default_mode": "accelerated",
    "default_rate": 10.0,
    "rate_bounds": {
      "minimum": 0.0,
      "maximum": 100.0
    },
    "lockstep_deadline_seconds": 60.0,
    "idle_poll_seconds": 0.1,
    "liveness_window_seconds": 15.0,
    "run": {
      "id": "droplet-001",
      "code_revision": "workspace",
      "code_dirty": true
    },
    "manifest": {
      "directory": "/srv/drogna/run",
      "file": "run-manifest.json"
    }
  }
}
