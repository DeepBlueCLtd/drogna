{
  "component": {
    "id": "offload",
    "description": "C-17: packages a run's profiles as CF NetCDF and evicts nothing without a receipt.",
    "heartbeat_interval_seconds": 5.0
  },
  "clock": {
    "endpoint": "http://clock:8090",
    "routes": {
      "snapshot": "/clock/snapshot",
      "control": "/clock/control"
    },
    "mode": "accelerated",
    "stale_after_gap": 4,
    "timeout_seconds": 5.0
  },
  "seed": {
    "root": 20260826,
    "stream": "offload"
  },
  "broker": {
    "url": "mqtt://drogna_control@broker:1883",
    "client_id": "offload",
    "keepalive_seconds": 30
  },
  "logging": {
    "level": "INFO"
  },
  "offload": {
    "source": {
      "directory": "/var/lib/drogna/run",
      "observations_file": "observations.jsonl",
      "run_manifest_file": "run-manifest.json"
    },
    "staging": {
      "directory": "/var/lib/drogna/offload/staging",
      "bundle_suffix": ".nc",
      "manifest_suffix": ".manifest.json",
      "partial_suffix": ".partial"
    },
    "release": {
      "path_prefix": "/released/",
      "directory": "/var/lib/drogna/released"
    },
    "ledger": {
      "directory": "/var/lib/drogna/offload/ledger",
      "file": "bundles.jsonl"
    },
    "destination": {
      "id": "archive",
      "endpoint": "http://archive:8110",
      "routes": {
        "upload": "/objects/{name}",
        "commit": "/objects/{name}/commit",
        "receipt": "/objects/{name}/receipt"
      },
      "timeout_seconds": 5.0
    },
    "retention": {
      "maximum_staging_bytes": 268435456,
      "maximum_age_simulation_seconds": 86400.0
    },
    "attributes": {
      "allowlist": [
        "Conventions",
        "featureType",
        "title",
        "summary",
        "format_version",
        "bundle_id",
        "run_reference",
        "time_coverage_start",
        "time_coverage_end",
        "standard_name",
        "long_name",
        "units",
        "axis",
        "positive",
        "cf_role",
        "coordinates",
        "sample_dimension",
        "instance_dimension"
      ]
    },
    "compliance": {
      "convention_version": "CF-1.10"
    },
    "export": {
      "window": {
        "length_simulation_seconds": 3600.0
      }
    }
  }
}
