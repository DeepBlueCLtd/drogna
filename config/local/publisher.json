    },
    "catalogue": {
      "root_directory": "/var/lib/drogna/coverage",
      "runs_dirname": "runs",
      "current_pointer": "current",
      "partial_suffix": ".partial",
      "forecast_file": "forecast.nc",
      "uncertainty_file": "uncertainty.nc",
      "manifest_file": "run-manifest.json"
    },
    "collections": {
      "forecast": "forecast"
    }
  }
