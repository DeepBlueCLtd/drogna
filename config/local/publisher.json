{
  "component": {
    "id": "publisher",
    "description": "C-14: makes a completed run visible in one operation and announces it.",
    "heartbeat_interval_seconds": 5.0
  },
  "clock": {
    "endpoint": "http://clock:8090",
    "routes": {
      "snapshot": "/clock/snapshot",
      "control": "/clock/control"
    },
    "mode": "accelerated",
    "stale_after_gap": 4,
    "timeout_seconds": 5.0
  },
  "seed": {
    "root": 20260826,
    "stream": "publisher"
  },
  "broker": {
    "url": "mqtt://drogna_control@broker:1883",
