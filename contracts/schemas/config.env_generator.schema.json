{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.harness.invalid/config.env_generator.schema.json",
  "title": "drogna environment generator configuration",
  "description": "Configuration for C-02, the synthetic environment generator. Every value that shapes the generated world arrives here and is echoed into the ground-truth manifest, so a field is reproducible from configuration and seed alone. The common sections are referenced from config.common.schema.json rather than restated. Unknown keys are rejected: a typo in a key is a startup failure, never a silent default.",
  "type": "object",
  "required": ["component", "clock", "seed", "logging", "env_generator"],
  "additionalProperties": false,
  "properties": {
    "component": { "$ref": "https://schemas.harness.invalid/config.common.schema.json#/$defs/component" },
    "clock": { "$ref": "https://schemas.harness.invalid/config.common.schema.json#/$defs/clock" },
    "seed": { "$ref": "https://schemas.harness.invalid/config.common.schema.json#/$defs/seed" },
    "broker": { "$ref": "https://schemas.harness.invalid/config.common.schema.json#/$defs/broker" },
    "logging": { "$ref": "https://schemas.harness.invalid/config.common.schema.json#/$defs/logging" },
    "env_generator": {
      "title": "The generated world",
      "type": "object",
      "required": [
        "grid",
        "stored_dtype",
        "background",
        "pressure",
        "features",
        "timescale",
        "bounds",
        "output",
        "rng"
      ],
      "additionalProperties": false,
      "properties": {
        "grid": {
          "title": "The four axes",
          "description": "Latitude, longitude and depth are given as extent and count so that spacing is exact rather than accumulated. Time is given as an offset from the simulation instant of generation, a step and a count, because the generator has no origin of its own: its time origin is the clock's.",
          "type": "object",
          "required": ["latitude", "longitude", "depth", "time"],
          "additionalProperties": false,
          "properties": {
            "latitude": { "$ref": "#/$defs/spatial_axis" },
            "longitude": { "$ref": "#/$defs/spatial_axis" },
            "depth": { "$ref": "#/$defs/spatial_axis" },
            "time": {
              "type": "object",
              "required": ["start_offset_seconds", "step_seconds", "count"],
              "additionalProperties": false,
              "properties": {
                "start_offset_seconds": {
                  "type": "number",
                  "description": "Offset of the first time step from the simulation instant of generation, in seconds."
                },
                "step_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Spacing of the time axis, in seconds of simulation time."
                },
                "count": {
                  "type": "integer",
                  "minimum": 2,
                  "description": "Number of time steps. At least two, or a drifting feature has nowhere to drift to."
                }
              }
            }
          }
        },
        "stored_dtype": {
          "type": "string",
          "enum": ["float32", "float64"],
          "description": "Width of the stored data variables. Recorded in the manifest and used to derive the evaluator's agreement tolerance, because byte-identity does not survive a silent change of precision."
        },
        "background": {
          "title": "Background stratification",
          "description": "The base state on which every feature is composed: exponential relaxation from a surface value to a deep value with depth, for temperature and for salinity independently.",
          "type": "object",
          "required": [
            "surface_temperature_c",
            "deep_temperature_c",
            "temperature_scale_depth_m",
            "surface_salinity_psu",
            "deep_salinity_psu",
            "salinity_scale_depth_m"
          ],
          "additionalProperties": false,
          "properties": {
            "surface_temperature_c": { "type": "number" },
            "deep_temperature_c": { "type": "number" },
            "temperature_scale_depth_m": { "type": "number", "exclusiveMinimum": 0 },
            "surface_salinity_psu": { "type": "number", "minimum": 0 },
            "deep_salinity_psu": { "type": "number", "minimum": 0 },
            "salinity_scale_depth_m": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "pressure": {
          "title": "Pressure from depth",
          "description": "Pressure is derived from depth rather than generated independently. An independent pressure would be unphysical and would make the sound speed derivation meaningless.",
          "type": "object",
          "required": ["relation", "dbar_per_metre", "surface_dbar"],
          "additionalProperties": false,
          "properties": {
            "relation": {
              "type": "string",
              "const": "linear-hydrostatic",
              "description": "The named relation. A second relation is a new name and a generator version bump, never a changed coefficient under the same name."
            },
            "dbar_per_metre": { "type": "number", "exclusiveMinimum": 0 },
            "surface_dbar": { "type": "number", "minimum": 0 }
          }
        },
        "features": {
          "title": "The four seeded features",
          "description": "Exactly four kinds, because SRD FR-03 names exactly four. Each carries its own decorrelation timescale, which is authored here and evaluated as a field.",
          "type": "object",
          "required": ["eddy", "front", "thermocline", "moving"],
          "additionalProperties": false,
          "properties": {
            "eddy": {
              "type": "object",
              "required": [
                "id",
                "centre_latitude",
                "centre_longitude",
                "radius_km",
                "strength_c",
                "salinity_strength_psu",
                "sign",
                "depth_centre_m",
                "depth_half_thickness_m",
                "timescale_seconds",
                "jitter"
              ],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "#/$defs/feature_id" },
                "centre_latitude": { "type": "number", "minimum": -90, "maximum": 90 },
                "centre_longitude": { "type": "number", "minimum": -180, "maximum": 180 },
                "radius_km": { "type": "number", "exclusiveMinimum": 0 },
                "strength_c": { "type": "number", "exclusiveMinimum": 0 },
                "salinity_strength_psu": { "type": "number" },
                "sign": {
                  "type": "integer",
                  "enum": [-1, 1],
                  "description": "Minus one for a cold core, plus one for a warm core."
                },
                "depth_centre_m": { "type": "number", "minimum": 0 },
                "depth_half_thickness_m": { "type": "number", "exclusiveMinimum": 0 },
                "timescale_seconds": { "$ref": "#/$defs/timescale_seconds" },
                "jitter": {
                  "type": "object",
                  "required": ["centre_km", "radius_fraction", "strength_fraction", "timescale_fraction"],
                  "additionalProperties": false,
                  "description": "Amplitudes of the authored jitter drawn through the RNG port, in the order the keys are listed here. The jittered values are what the manifest records, so the manifest stays sufficient on its own.",
                  "properties": {
                    "centre_km": { "type": "number", "minimum": 0 },
                    "radius_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
                    "strength_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
                    "timescale_fraction": { "type": "number", "minimum": 0, "maximum": 1 }
                  }
                }
              }
            },
            "front": {
              "type": "object",
              "required": [
                "id",
                "anchor_latitude",
                "anchor_longitude",
                "bearing_degrees",
                "sharpness_km",
                "amplitude_c",
                "salinity_amplitude_psu",
                "depth_scale_m",
                "timescale_seconds",
                "jitter"
              ],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "#/$defs/feature_id" },
                "anchor_latitude": { "type": "number", "minimum": -90, "maximum": 90 },
                "anchor_longitude": { "type": "number", "minimum": -180, "maximum": 180 },
                "bearing_degrees": { "type": "number", "minimum": 0, "maximum": 360 },
                "sharpness_km": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Half-width of the transition. The manifest records its ratio to the horizontal grid spacing, so an under-resolved front's recovery error can be interpreted rather than merely reported."
                },
                "amplitude_c": { "type": "number", "exclusiveMinimum": 0 },
                "salinity_amplitude_psu": { "type": "number" },
                "depth_scale_m": { "type": "number", "exclusiveMinimum": 0 },
                "timescale_seconds": { "$ref": "#/$defs/timescale_seconds" },
                "jitter": {
                  "type": "object",
                  "required": ["anchor_km", "bearing_degrees", "sharpness_fraction", "amplitude_fraction", "timescale_fraction"],
                  "additionalProperties": false,
                  "properties": {
                    "anchor_km": { "type": "number", "minimum": 0 },
                    "bearing_degrees": { "type": "number", "minimum": 0 },
                    "sharpness_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
                    "amplitude_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
                    "timescale_fraction": { "type": "number", "minimum": 0, "maximum": 1 }
                  }
                }
              }
            },
            "thermocline": {
              "type": "object",
              "required": [
                "id",
                "depth_m",
                "thickness_m",
                "temperature_drop_c",
                "salinity_rise_psu",
                "timescale_seconds",
                "jitter"
              ],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "#/$defs/feature_id" },
                "depth_m": { "type": "number", "minimum": 0 },
                "thickness_m": { "type": "number", "exclusiveMinimum": 0 },
                "temperature_drop_c": { "type": "number", "exclusiveMinimum": 0 },
                "salinity_rise_psu": { "type": "number" },
                "timescale_seconds": { "$ref": "#/$defs/timescale_seconds" },
                "jitter": {
                  "type": "object",
                  "required": ["depth_m", "thickness_fraction", "drop_fraction", "timescale_fraction"],
                  "additionalProperties": false,
                  "properties": {
                    "depth_m": { "type": "number", "minimum": 0 },
                    "thickness_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
                    "drop_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
                    "timescale_fraction": { "type": "number", "minimum": 0, "maximum": 1 }
                  }
                }
              }
            },
            "moving": {
              "type": "object",
              "required": [
                "id",
                "centre_latitude",
                "centre_longitude",
                "radius_km",
                "strength_c",
                "salinity_strength_psu",
                "sign",
                "depth_centre_m",
                "depth_half_thickness_m",
                "drift_east_km_per_day",
                "drift_north_km_per_day",
                "timescale_seconds",
                "jitter"
              ],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "#/$defs/feature_id" },
                "centre_latitude": { "type": "number", "minimum": -90, "maximum": 90 },
                "centre_longitude": { "type": "number", "minimum": -180, "maximum": 180 },
                "radius_km": { "type": "number", "exclusiveMinimum": 0 },
                "strength_c": { "type": "number", "exclusiveMinimum": 0 },
                "salinity_strength_psu": { "type": "number" },
                "sign": { "type": "integer", "enum": [-1, 1] },
                "depth_centre_m": { "type": "number", "minimum": 0 },
                "depth_half_thickness_m": { "type": "number", "exclusiveMinimum": 0 },
                "drift_east_km_per_day": {
                  "type": "number",
                  "description": "Eastward component of the drift velocity. Its position at any time is analytic, so it need not be stepped through the field."
                },
                "drift_north_km_per_day": { "type": "number" },
                "timescale_seconds": { "$ref": "#/$defs/timescale_seconds" },
                "jitter": {
                  "type": "object",
                  "required": ["centre_km", "radius_fraction", "strength_fraction", "drift_fraction", "timescale_fraction"],
                  "additionalProperties": false,
                  "properties": {
                    "centre_km": { "type": "number", "minimum": 0 },
                    "radius_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
                    "strength_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
                    "drift_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
                    "timescale_fraction": { "type": "number", "minimum": 0, "maximum": 1 }
                  }
                }
              }
            }
          }
        },
        "timescale": {
          "title": "The decorrelation timescale field",
          "description": "ADR-0002: the timescale is a field, authored per feature over a domain-wide background and evaluated per location. Quiet water has a timescale because FR-08 requires quiet water to be left alone, and the planner scores every cell.",
          "type": "object",
          "required": ["background_seconds", "blending_rule", "floor_ratio"],
          "additionalProperties": false,
          "properties": {
            "background_seconds": {
              "$ref": "#/$defs/timescale_seconds",
              "description": "The timescale of water no feature overlaps. Ground truth, and recorded in the manifest."
            },
            "blending_rule": {
              "type": "string",
              "const": "additive-rate-blend-normalised",
              "description": "How a feature's timescale combines with the background. Named rather than assumed, because ADR-0002 leaves the choice open and two features may overlap."
            },
            "floor_ratio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Smallest permitted ratio of any authored timescale to the time step. A timescale the time axis cannot express would silently mislead the revisit cadence of FR-08, so the generator refuses rather than writing it."
            }
          }
        },
        "bounds": {
          "title": "Physical bounds",
          "description": "The composed field is checked against these before anything is written. An unphysical world written quietly is worse than a refusal.",
          "type": "object",
          "required": ["temperature_c", "salinity_psu", "pressure_dbar"],
          "additionalProperties": false,
          "properties": {
            "temperature_c": { "$ref": "#/$defs/bound" },
            "salinity_psu": { "$ref": "#/$defs/bound" },
            "pressure_dbar": { "$ref": "#/$defs/bound" }
          }
        },
        "output": {
          "title": "Where the field and its manifest go",
          "description": "Names come from configuration and are echoed into the manifest, so the coverage store's cataloguing convention can be applied without the generator knowing it.",
          "type": "object",
          "required": ["directory", "field_file", "manifest_file"],
          "additionalProperties": false,
          "properties": {
            "directory": { "type": "string", "minLength": 1 },
            "field_file": { "type": "string", "minLength": 1 },
            "manifest_file": { "type": "string", "minLength": 1 }
          }
        },
        "rng": {
          "title": "Randomness",
          "type": "object",
          "required": ["stream"],
          "additionalProperties": false,
          "properties": {
            "stream": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$",
              "description": "The named stream every draw in this component comes from, through harness_core.rng.rng_for."
            }
          }
        }
      }
    }
  },
  "$defs": {
    "spatial_axis": {
      "type": "object",
      "required": ["minimum", "maximum", "count"],
      "additionalProperties": false,
      "description": "An axis given as extent and count. Spacing is derived, so it is exact rather than accumulated.",
      "properties": {
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "count": { "type": "integer", "minimum": 2 }
      }
    },
    "bound": {
      "type": "object",
      "required": ["minimum", "maximum"],
      "additionalProperties": false,
      "properties": {
        "minimum": { "type": "number" },
        "maximum": { "type": "number" }
      }
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "Stable identifier for this feature, quoted by a recovery error so a figure can be attributed."
    },
    "timescale_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "A decorrelation timescale in seconds of simulation time."
    }
  }
}
