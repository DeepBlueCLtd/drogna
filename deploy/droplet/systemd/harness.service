# Brings drogna up at boot, so that a rebooted droplet returns to a healthy stack with
# nobody running anything (SRD NFR-06, FR-015).
#
# Installed by deploy/droplet/provision.sh, which substitutes @@DEPLOYMENT_ROOT@@ for the
# checkout it finds. The placeholder is why this file carries no path of its own.
#
# The containers themselves also carry a restart policy, so the daemon restores them
# without this unit. The unit exists for the case the policy cannot cover: a checkout that
# has moved on, a configuration that has changed, a volume that was removed. It converges
# the host on what the checkout says, rather than merely restarting what was last running.

[Unit]
Description=drogna harness
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@@DEPLOYMENT_ROOT@@
ExecStart=@@DEPLOYMENT_ROOT@@/scripts/up.sh droplet
ExecStop=@@DEPLOYMENT_ROOT@@/scripts/down.sh droplet
TimeoutStartSec=1200

[Install]
WantedBy=multi-user.target
