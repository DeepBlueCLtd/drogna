# Environment contract for deploy/compose.yaml.
#
# This file is tracked and carries no values. `scripts/up.sh` renders it into the untracked
# `deploy/.env` by reading `config/<destination>/deployment.json`; the comment above each
# name gives the configuration key it mirrors, so that a value can always be traced back to
# the destination that set it. A name that appears here and nowhere in the configuration is
# either derived (marked so) or a secret (marked so).
#
# Adding a name here without adding the key it mirrors is an error the renderer reports.

# --- identity and selection ---------------------------------------------------------

# deployment.project_name — Compose project name, and the prefix of every container,
# network and volume the deployment creates.
HARNESS_PROJECT_NAME=

# deployment.profiles.active — the profiles started at this destination, comma separated.
# Compose reads this name itself, which is how the active profile reaches the stack from
# configuration rather than from the command line.
COMPOSE_PROFILES=

# --- build ---------------------------------------------------------------------------

# derived — absolute path of the repository root on this host, found from the position of
# the run script. The build context for every image, because the uv workspace lock and the
# client sources both sit above deploy/.
HARNESS_BUILD_CONTEXT=

# derived — Dockerfile paths relative to the build context.
HARNESS_DOCKERFILE_PYTHON=
HARNESS_DOCKERFILE_CLIENT=
HARNESS_DOCKERFILE_QUERY=
HARNESS_DOCKERFILE_PROXY=

# --- runtime policy ------------------------------------------------------------------

# deployment.runtime.restart_policy
HARNESS_RESTART_POLICY=
# deployment.runtime.log_driver
HARNESS_LOG_DRIVER=
# deployment.runtime.log_max_size
HARNESS_LOG_MAX_SIZE=
# deployment.runtime.log_max_files
HARNESS_LOG_MAX_FILES=
# deployment.runtime.healthcheck.interval
HARNESS_HEALTHCHECK_INTERVAL=
# deployment.runtime.healthcheck.timeout
HARNESS_HEALTHCHECK_TIMEOUT=
# deployment.runtime.healthcheck.retries
HARNESS_HEALTHCHECK_RETRIES=
# deployment.runtime.healthcheck.start_period
HARNESS_HEALTHCHECK_START_PERIOD=

# deployment.resources.default.memory / .cpus
HARNESS_LIMIT_MEMORY=
HARNESS_LIMIT_CPUS=
# deployment.resources.observations.memory / .cpus — the one service that outgrows the
# default. A further override is a key in deployment.resources plus two names here.
HARNESS_LIMIT_MEMORY_OBSERVATIONS=
HARNESS_LIMIT_CPUS_OBSERVATIONS=

# --- paths inside containers ----------------------------------------------------------

# deployment.container_paths.app_root
HARNESS_APP_ROOT=
# deployment.container_paths.config_dir
HARNESS_CONFIG_DIR=
# deployment.container_paths.coverage_root
HARNESS_COVERAGE_ROOT=
# deployment.container_paths.static_root
HARNESS_STATIC_ROOT=
# deployment.container_paths.nginx_template_dir — where the nginx images look for the
# configuration templates they expand at start-up.
HARNESS_NGINX_TEMPLATE_DIR=
# deployment.container_paths.broker_config_dir
HARNESS_BROKER_CONFIG_DIR=
# deployment.container_paths.broker_data_dir
HARNESS_BROKER_DATA_DIR=
# deployment.container_paths.database_data_dir
HARNESS_DATABASE_DATA_DIR=

# --- paths on the host ------------------------------------------------------------------

# derived from the repository root and the destination name — the directory of
# configuration files this destination mounts into every container, read-only.
HARNESS_CONFIG_HOST_DIR=
# deployment.host_paths.broker_config_dir, resolved against the repository root.
HARNESS_BROKER_CONFIG_HOST_DIR=
# deployment.host_paths.runtime_dir, resolved against the repository root. Holds the
# generated environment file and the seeding record; untracked, and removed by reset.
HARNESS_RUNTIME_HOST_DIR=

# --- published ports --------------------------------------------------------------------
#
# One HARNESS_PUBLISH_<SERVICE> per entry in deployment.network.publish, rendered as
# bind:host_port:container_port, and one HARNESS_PORT_<SERVICE> carrying the container port
# on its own. A service with no entry publishes nothing.

# deployment.network.publish.clock
HARNESS_PUBLISH_CLOCK=
HARNESS_PORT_CLOCK=
# deployment.network.publish.broker
HARNESS_PUBLISH_BROKER=
HARNESS_PORT_BROKER=
# deployment.network.publish.observations
HARNESS_PUBLISH_OBSERVATIONS=
HARNESS_PORT_OBSERVATIONS=
# deployment.network.publish.query
HARNESS_PUBLISH_QUERY=
HARNESS_PORT_QUERY=
# deployment.network.publish.proxy
HARNESS_PUBLISH_PROXY=
HARNESS_PORT_PROXY=
# deployment.network.publish.client
HARNESS_PUBLISH_CLIENT=
HARNESS_PORT_CLIENT=
# deployment.network.publish.telemetry
HARNESS_PUBLISH_TELEMETRY=
HARNESS_PORT_TELEMETRY=

# --- health check targets ----------------------------------------------------------------
#
# derived from deployment.network.publish — the address a container uses to check its own
# listener, over the internal network, by service name. Composed here so that no URL is
# written into the Compose file.
HARNESS_HEALTH_URL_QUERY=
HARNESS_HEALTH_URL_PROXY=
HARNESS_HEALTH_URL_CLIENT=

# --- the destination's advertised address -------------------------------------------------

# deployment.public_url — printed by the run scripts. Nothing in the stack resolves it.
HARNESS_PUBLIC_URL=

# --- database -----------------------------------------------------------------------------

# deployment.database.name
HARNESS_DATABASE_NAME=
# deployment.database.user
HARNESS_DATABASE_USER=

# --- secrets --------------------------------------------------------------------------------
#
# Generated at deploy time into deploy/.env, which is untracked. A secret is generated once
# and reused on every subsequent run, so that a re-run does not invalidate a store that was
# initialised with the previous value; `scripts/reset.sh` is what regenerates it.
HARNESS_DATABASE_PASSWORD=

# --- generated: one name per service in deploy/compose.yaml ------------------------------------
#
# HARNESS_CONFIG_PATH_<SERVICE> gives the container-side path of that service's own
# configuration file. Empty means the component has not been built yet and has no file in
# this destination; it is not a statement about what is alive.
# Renderer appends below this line. Do not edit by hand.
