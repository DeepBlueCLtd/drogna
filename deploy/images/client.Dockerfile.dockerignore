# Build context for the client image. BuildKit reads this in preference to any ignore file
# at the context root, so each image definition states its own context and no image pays
# for another's.
#
# The context root is the repository root, because that is where `client/` sits. Excluded
# here: everything the client build does not read, and in particular the host's own
# installed dependencies and build output. Copying those in is not merely slow — the
# package manager finds a directory it did not create, tries to purge it, and fails for
# want of a terminal.

.git
.github
.venv
.pytest_cache
.ruff_cache
**/node_modules
**/__pycache__
**/dist
client/coverage

# Nothing outside `client/` and this file's own image definition is read by that build.
config
contracts
!contracts/schemas
# The topology matrix (018) imports the generated artefact directly, the way schemas.ts
# imports the masters. The exception must follow the exclusion: Docker takes the last
# matching pattern.
!contracts/topology.json
docs
libs
services
site
specs
spikes
scripts
tests
deploy/lib
deploy/seed.d
deploy/droplet
deploy/.env
