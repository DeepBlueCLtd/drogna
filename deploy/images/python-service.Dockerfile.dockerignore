# Build context for the Python service image. See the note in
# client.Dockerfile.dockerignore: BuildKit reads a per-Dockerfile ignore file in preference
# to one at the context root, so each image states its own context.
#
# This build reads the workspace lock, `libs/` and `services/`. Everything else is weight,
# and the host's own virtual environment and caches are worse than weight: they are built
# for the host's interpreter, not the image's.

.git
.github
.venv
.pytest_cache
.ruff_cache
**/node_modules
**/__pycache__
**/*.pyc
**/dist
client
site
specs
spikes
docs
tests
deploy/lib
deploy/seed.d
deploy/droplet
deploy/.env
