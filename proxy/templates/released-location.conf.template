    # @{identifier}: released, and therefore reachable.
    #
    # Two locations, and the pair is the point. `= @{location_path}` matches the
    # collection itself and nothing else; `^~ @{location_path}/` matches what is beneath
    # it. A single prefix location would match on the string rather than on the segment,
    # so releasing `@{identifier}` would silently release `@{identifier}-raw` as well —
    # which is spec.md's fifth scenario for this story, and the reason this is written as
    # two exact-boundary locations rather than one convenient one.
    #
    # `proxy_pass` is a content-phase handler, so it runs after the access phase and an
    # uncleared caller never reaches upstream. Nothing here can rewrite a response body:
    # `proxy_intercept_errors` is left off, so even an upstream error reaches the caller
    # exactly as upstream wrote it (FR-005).
    location = @{location_path} {
        set $harness_rule "@{rule}";
        proxy_pass @{upstream};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ @{location_path}/ {
        set $harness_rule "@{rule}";
        proxy_pass @{upstream}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
