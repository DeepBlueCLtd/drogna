    # The control-namespace upgrade location (ADR-0008). MQTT over WebSockets, proxied to
    # the broker's WebSocket listener — which is deliberately not published to the host,
    # so this is the only way into the control namespace.
    #
    # It is exactly one path, not a subtree. A static prefix can afford a subtree because
    # every request under it is inspected; this cannot, because policy here is evaluated
    # once, at the upgrade, and the connection then persists carrying traffic the proxy
    # does not inspect per message. So the surface is made as small as the client needs,
    # which is one URL.
    #
    # What a subscriber may then receive is not settled here. It is settled by the
    # broker's access control lists, where the browser identity is subscribe-only on the
    # control namespace and carries no rule granting it obs/ — where measurement locations
    # travel. That is tested at a running broker in
    # tests/integration/test_topic_isolation.py, and asserted from this side in
    # tests/leakage/test_released_list.py. Nothing this file could say would constrain it.
    location = @{upgrade_prefix} {
        set $harness_rule "@{rule}";

        # The one place in this file where the boundary is not this proxy's, and the one
        # opt-out from the server-level clearance. Decided by the owner on 28 August 2026:
        # ADR-0020 (accepted) delegates the control namespace's clearance to the broker's
        # ACL, and ADR-0025 confirms the delegation does not transfer to any REST surface
        # now that the page shares this origin — so this stays the only opt-out.
        #
        # A browser cannot present an HTTP Basic credential on a WebSocket: the `WebSocket`
        # constructor takes a URL and a subprotocol list and has nowhere to put a header,
        # and mqtt.js in a browser builds on that same constructor. Server-level
        # `auth_basic` therefore made this location unreachable by the only client that
        # uses it — `GET /ctl status=401 rule=allow-upgrade` in this proxy's own access
        # log, refused at the access phase before the upgrade ever happened.
        #
        # The clearance for the control namespace is delegated to the broker, which is not
        # the absence of one: the broker runs `allow_anonymous false` with a per-role ACL,
        # the client connects as `drogna_viewer` with a secret the render injects, and that
        # identity is subscribe-only on ctl/ and carries no rule granting obs/. The
        # released prefix is untouched and still binary at this proxy.
        auth_basic off;

        proxy_pass @{upstream};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
@{subprotocol_header}        proxy_buffering off;
        proxy_read_timeout @{read_timeout}s;
    }
