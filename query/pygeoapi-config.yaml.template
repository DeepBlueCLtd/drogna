# The query layer's pygeoapi configuration, as a template. Rendered by render_config.py
# from the destination configuration; the rendered file is the only one pygeoapi ever reads.
#
# A pygeoapi configuration is conventionally written full of absolute paths — the data file
# of every collection, the schema of every provider. None appear here, and none may: every
# placeholder below is filled from config/<destination>/query.json, and a placeholder with no
# value is a startup failure naming the key rather than a default nobody chose
# (Constitution IV, FR-018).
#
# Two collections, and only two, because collections are not how runs are addressed. The
# forecast collection serves whichever run the coverage store says is current, resolved at
# request time by the catalogue; earlier runs are reached as EDR *instances* of that same
# collection. Adding a run therefore adds no collection, edits no file and restarts nothing
# (FR-017, FR-021). It also keeps the path space a fixed shape, which is what makes
# prefix-based default-deny at the reverse proxy viable (FR-023).
#
# Both providers are named by dotted module path. pygeoapi's load_plugin splits on the last
# dot and imports the class, so nothing is registered anywhere; the whole of the wiring is
# that PYTHONPATH reaches the directory this file's siblings live in.

server:
  bind:
    host: ${bind_host}
    port: ${bind_port}
  url: ${public_url}
  mimetype: application/json; charset=UTF-8
  encoding: utf-8
  language: en-GB
  cors: false
  pretty_print: false
  limits:
    default_items: ${page_size_default}
    max_items: ${page_size_maximum}
  map:
    url: ${map_tile_url}
    attribution: ${map_attribution}

logging:
  level: ${log_level}

metadata:
  identification:
    title:
      en: drogna query layer
    description:
      en: >-
        Standards-based read access to a synthetic environmental harness. Every value served
        here is synthetic and the numerics are deliberately fake. OGC API-EDR over the
        coverage store, returning CoverageJSON; a stated subset of OGC SensorThings Part 1
        (Sensing) over the observation store, which is not conformant and says so.
    keywords:
      en:
        - synthetic
        - environmental
        - coverage
        - edr
    keywords_type: theme
    terms_of_service: ${terms_of_service}
    url: ${public_url}
  license:
    name: ${licence_name}
    url: ${licence_url}
  provider:
    name: ${provider_name}
    url: ${public_url}
  contact:
    name: ${provider_name}
    url: ${public_url}
    role: pointOfContact

resources:
  forecast:
    type: collection
    title:
      en: Forecast and uncertainty, current run
    description: >-
      The model run the coverage store currently names, with the forecast parameters and the
      uncertainty parameter together as parameters of one collection. Synthetic data. Earlier
      runs remain addressable as instances of this collection, so two runs can be compared.
      There is no freshness endpoint: a consumer hears about a new run on ctl/run-published,
      because this service has no notification mechanism and polling it would invent one.
    keywords:
      en:
        - forecast
        - uncertainty
        - synthetic
    extents:
      spatial:
        bbox: ${domain_bbox}
        crs: http://www.opengis.net/def/crs/OGC/1.3/CRS84
      # Unquoted on purpose, so YAML parses these as timestamps rather than as strings.
      # pygeoapi's validate_datetime reads .tzinfo off the configured extent and reports
      # "Configured times should be RFC3339" if it is handed text — measured, not guessed.
      temporal:
        begin: ${domain_begin}
        end: ${domain_end}
    providers:
      - type: edr
        name: plugins.edr_trajectory.DrognaTrajectoryEDRProvider
        data: ${coverage_root}
        x_field: ${axis_longitude}
        y_field: ${axis_latitude}
        z_field: ${axis_depth}
        time_field: ${axis_time}
        options: ${coverage_options}

  observations:
    type: collection
    title:
      en: Observations, SensorThings Part 1 (Sensing) subset
    description: >-
      A stated subset of OGC SensorThings API Part 1 (Sensing), projected read-only from the
      observation store. This interface is not conformant and claims no conformance. Things,
      Sensors, ObservedProperties, Datastreams, Observations and FeaturesOfInterest are
      served; Locations and HistoricalLocations are not, and the conformance statement gives
      the reason rather than leaving the absence to look like an oversight. Every value is
      synthetic.
    keywords:
      en:
        - sensorthings
        - observations
        - synthetic
    extents:
      spatial:
        bbox: ${domain_bbox}
        crs: http://www.opengis.net/def/crs/OGC/1.3/CRS84
      # Unquoted on purpose, so YAML parses these as timestamps rather than as strings.
      # pygeoapi's validate_datetime reads .tzinfo off the configured extent and reports
      # "Configured times should be RFC3339" if it is handed text — measured, not guessed.
      temporal:
        begin: ${domain_begin}
        end: ${domain_end}
    providers:
      - type: feature
        name: plugins.sensorthings_provider.DrognaSensorThingsProvider
        data: ${observations_dsn}
        id_field: id
        options: ${sensorthings_options}
