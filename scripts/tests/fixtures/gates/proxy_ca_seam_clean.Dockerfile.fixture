# A fixture. The fetch is inside the seam, and — this is the part that matters — the mount
# is on the instruction's first line while the fetch is on its last. A gate reading line by
# line would report this, which is why the clean fixture is written over several lines.
FROM alpine:3

RUN --mount=type=secret,id=proxy_ca,target=/tmp/proxy-ca.crt,required=false \
    sh -c 'if [ -s /tmp/proxy-ca.crt ]; then \
             cat /tmp/proxy-ca.crt >> /etc/ssl/certs/ca-certificates.crt; \
           fi; \
           apk add --no-cache python3'

# A RUN that reaches nothing is not this gate's business however it is written.
RUN echo "no network here" > /opt/example/note
