# A service package that another service package is about to reach into. Nothing here is
# unusual: it is an ordinary component, which is the point — the fault is in the borrowing.
[project]
name = "probe-lender"
version = "0.1.0"
description = "A stand-in component, so the gate has two services to see a boundary between"
requires-python = ">=3.11"
dependencies = [
    "harness-core",
]

[tool.hatch.build.targets.wheel]
packages = ["src/probe_lender"]
