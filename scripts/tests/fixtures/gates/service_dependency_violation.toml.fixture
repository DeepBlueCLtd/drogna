# A service package declaring a dependency on another service package, with nothing said
# about why. This is the shape the gate exists to catch.
[project]
name = "probe-borrower"
version = "0.1.0"
description = "A stand-in component that reaches into another one"
requires-python = ">=3.11"
dependencies = [
    "harness-core",
    "probe-lender",
]

[tool.hatch.build.targets.wheel]
packages = ["src/probe_borrower"]
