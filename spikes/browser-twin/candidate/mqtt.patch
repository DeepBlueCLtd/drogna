+ * One client, two places a message can come from. A deployment with a broker behind it
+ * serves a WebSocket URL and nothing here changes; a page with its components running in
+ * the browser serves a bus URL and the same subscription code receives from the in-page
+ * fabric instead. The choice is made from the document, which is the client's one
+ * permitted source of deployment knowledge (Constitution IV), and never from a build
+ * flag, a query parameter or a literal in this file.
+ *
+ * Nothing about liveness changes with the choice. Either way a component is lit because
+ * a message from it arrived, and neither branch can manufacture one.
+ */
+const chooseConnector: Connector = (url, options) =>
+  isBusUrl(url) ? connectOverBus(url, options) : connectOverWebSocket(url, options);
