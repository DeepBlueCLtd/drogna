# The pygeoapi image with Shapely brought up to the pin SRD FR-51 requires.
#
# SPIKE CODE. Throwaway.
#
# The published pygeoapi image ships Shapely 2.0.3, which is below the pin. At that
# version the M ordinate of an EDR trajectory's LINESTRINGZM is unreachable from
# Python and a LINESTRINGZM loses M altogether on round-trip, so per-vertex arrival
# times vanish silently and FR-20 fails without raising. Shapely 2.1 wheels bundle
# GEOS 3.13, satisfying the GEOS half of the pin at the same time.
FROM geopython/pygeoapi@sha256:03305eb4f958c6a3c0cbeb89ae5a1010184050d990c61f6cf7e9ed7c0cbb3269

RUN pip3 install --no-cache-dir --break-system-packages 'shapely>=2.1,<3' \
    && python3 -c "import shapely; print('shapely', shapely.__version__, 'geos', shapely.geos_version)"
