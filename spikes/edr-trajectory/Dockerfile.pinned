# syntax=docker/dockerfile:1
# The pygeoapi image with Shapely brought up to the pin SRD FR-51 requires.
#
# SPIKE CODE. Throwaway.
#
# The published pygeoapi image ships Shapely 2.0.3, which is below the pin. At that
# version the M ordinate of an EDR trajectory's LINESTRING M is unreachable from Python
# and a LINESTRING ZM loses M altogether on round-trip, so per-vertex arrival times
# vanish silently and FR-20 fails without raising. Shapely 2.1 wheels bundle GEOS 3.13,
# which satisfies the GEOS half of the pin at the same time.
#
# The base image is pinned by digest so the finding names something reproducible.
FROM geopython/pygeoapi@sha256:03305eb4f958c6a3c0cbeb89ae5a1010184050d990c61f6cf7e9ed7c0cbb3269

# A build behind a TLS-terminating egress proxy needs that proxy's CA to reach PyPI.
# The secret is optional: without one the certificate store is left alone. run.sh finds
# a bundle if the machine has one and passes it through.
RUN --mount=type=secret,id=proxy_ca,target=/tmp/proxy-ca.crt,required=false \
    sh -c 'if [ -s /tmp/proxy-ca.crt ]; then \
             cat /tmp/proxy-ca.crt >> /etc/ssl/certs/ca-certificates.crt; \
             export PIP_CERT=/etc/ssl/certs/ca-certificates.crt; \
           fi; \
           pip3 install --no-cache-dir --break-system-packages --ignore-installed "shapely>=2.1,<3" "numpy<2"' \
    && python3 -c "import shapely; print('shapely', shapely.__version__, 'geos', shapely.geos_version)"
